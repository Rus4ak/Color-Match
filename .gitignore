### Unity ###
# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
/ColorMatch/[Tt]emp/
/ColorMatch/[Oo]bj/
/ColorMatch/[Bb]uild/
/ColorMatch/[Bb]uilds/
/ColorMatch/[Ll]ogs/
/ColorMatch/[Uu]ser[Ss]ettings/
/ColorMatch/[Ll]ibrary/
/ColorMatch/Assets/**/Lightmap-*
/ColorMatch/Assets/**/LightingData.asset
/ColorMatch/Assets/**/ReflectionProbe-*

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/ColorMatch/[Mm]emoryCaptures/

# Recordings can get excessive in size
/ColorMatch/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Visual Studio cache directory
/ColorMatch/.vs/

# Autogenerated VS/MD/Consulo solution and project files
/ColorMatch/ExportedObj/
/ColorMatch/.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
/ColorMatch/sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
/ColorMatch/crashlytics-build.properties

# Packed Addressables
/ColorMatch/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/ColorMatch/[Aa]ssets/[Ss]treamingAssets/
/ColorMatch/[Aa]ssets/[Ss]treamingAssets.meta

# End of https://www.toptal.com/developers/gitignore/api/unity